# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

PORT=3001

# MongoDB Atlas / local connection string.
# Database name should be TOYS (already in the path below).
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/TOYS

# Secret used to sign and verify JWT tokens
TOKEN_SECRET=change_this_to_a_long_random_string
